# Copy to watchdog.env (not committed) next to docker-compose.watchdog.yml.
# Path to the worker's env file: the watchdog uses the same DATABASE_URL, REDIS_URL,
# REDIS_PREFIX and R2_* as the worker. Never commit the real file.
WORKER_ENV_FILE=C:/Users/<you>/Desktop/edu-backend-mobile-video/deploy/laptop-worker/.env.worker
# Image providing Node and the client libraries (any current edu-worker image).
WATCHDOG_IMAGE=edu-worker:30a21fa-priority-r2
WATCHDOG_LOG_DIR=C:/edu-watchdog/logs
# Safety thresholds (defaults shown).
WATCHDOG_OUTAGE_PAUSE_SEC=600
WATCHDOG_NETFAIL_THRESHOLD=3
WATCHDOG_NETFAIL_WINDOW_MIN=120
WATCHDOG_DRY_RUN=false
# What the watchdog's pause holds: `historical` (default) = the backlog only,
# new uploads keep encoding; `all` = every mobile encode. A worker image from
# before pause scopes existed treats either as `all`.
WATCHDOG_PAUSE_SCOPE=historical
