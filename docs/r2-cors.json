{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://student-dashoard.vercel.app",
          "http://localhost:3001"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}