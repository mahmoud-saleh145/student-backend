+      where: { failedAt: { not: null }, status: AccountDeletionStatus.PENDING },
+      orderBy: { failedAt: 'asc' },
+      take: 100,
+      select: {
+        id: true,
+        userId: true,
+        status: true,
+        requestedAt: true,
+        scheduledFor: true,
+        attempts: true,
+        failedAt: true,
+        lastError: true,
+      },
+    });
