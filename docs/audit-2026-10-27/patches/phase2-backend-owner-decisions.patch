+function build(opts: { password?: boolean; open?: Row | null } = {}) {
+  const calls: string[] = [];
+  const track = (name: string, impl: (...a: never[]) => unknown = async () => ({ count: 1 })) =>
+    jest.fn(async (...a: never[]) => {
