+      actorId: actor.id,
+      actorRole: actor.role,
+      action: AuditAction.UPDATE,
+      entity: 'account_deletion_request',
+      entityId: requestId,
+      note: `Failed account erasure re-queued by an administrator: ${reason}`,
+      ipAddress: meta.ip,
+      userAgent: meta.userAgent,
+      requestId: meta.requestId,
+    });
