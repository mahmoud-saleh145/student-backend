+describe('per-browser scope (one server process answers many students)', () => {
+  beforeEach(() => resetRefreshState());
+
+  test("one browser's sign-in does not invalidate another browser's in-flight refresh", () => {
+    const capturedByB = currentSessionGeneration('browser-B');
+    bumpSessionGeneration('browser-A'); // student A signs in or out
+    assert.equal(currentSessionGeneration('browser-B'), capturedByB);
+  });
+
+  test("a browser's own sign-out still invalidates its in-flight refresh", () => {
+    const captured = currentSessionGeneration('browser-A');
+    bumpSessionGeneration('browser-A');
+    assert.notEqual(currentSessionGeneration('browser-A'), captured);
+  });
+
+  test("one browser's failed refresh does not put other browsers into the cooldown", () => {
+    noteRefreshFailure(1_000, 'browser-A');
+    assert.equal(isRefreshCoolingDown(1_000, 'browser-A'), true);
+    assert.equal(isRefreshCoolingDown(1_000, 'browser-B'), false);
+  });
+
+  test("a scoped reset clears only that browser's cooldown and leaves in-flight refreshes alone", async () => {
+    noteRefreshFailure(1_000, 'browser-A');
+    noteRefreshFailure(1_000, 'browser-B');
+    let release: (v: RefreshOutcome) => void = () => undefined;
+    const pending = singleFlightRefresh('token-of-B', () => new Promise<RefreshOutcome>((r) => (release = r)));
+    resetRefreshState('browser-A');
+    assert.equal(isRefreshCoolingDown(1_000, 'browser-A'), false);
+    assert.equal(isRefreshCoolingDown(1_000, 'browser-B'), true);
+    assert.equal(inflightCount(), 1);
+    release({ ok: true, accessToken: 'a', refreshToken: 'r' });
+    await pending;
+  });
+});
