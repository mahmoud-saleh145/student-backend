+      const calls = source.match(/assertAuthorizedForProtectedContent\(\{[\s\S]*?\}\)/g) ?? [];
+      expect(calls).toHaveLength(expected);
+      for (const call of calls) expect(call).toMatch(/sessionDeviceId: (params\.)?user\.deviceId/);
+    }
+  });
+});
