diff --git a/e2e/teacher-notifications.spec.ts b/e2e/teacher-notifications.spec.ts
new file mode 100644
index 0000000..56d5c52
--- /dev/null
+++ b/e2e/teacher-notifications.spec.ts
@@ -0,0 +1,70 @@
+import type { Page } from '@playwright/test';
+
+import { expect, resetStub, test } from './fixtures';
+
+/**
+ * Owner decision D2: a teacher may notify the active students of their OWN
+ * course, from the course's Notifications tab, and nothing wider.
+ *
+ * The stub mirrors NotificationsController.announceToCourse: assignment is
+ * required, and the body may carry only the message.
+ */
+
+const STUB_API = `http://127.0.0.1:${process.env.STUB_API_PORT ?? 4599}`;
+
+async function sentAnnouncements(page: Page) {
+  const response = await page.request.get(`${STUB_API}/api/v1/__test__/course-announcements`);
+  const body = (await response.json()) as { data?: { sent?: Record<string, unknown>[] } };
+  return body.data?.sent ?? [];
+}
+
+test.beforeEach(async ({ page }) => {
+  await resetStub(page);
+});
+
+test('a teacher notifies the students of their own course from the course tab', async ({ page, signIn }) => {
+  await signIn('teacher');
+  await page.goto('/courses/course-1?tab=notify');
+
+  await page.getByLabel('Title').fill('Lecture moved');
+  await page.getByLabel('Message').fill('Tomorrow at 10:00 instead of 12:00.');
+  await page.getByRole('button', { name: 'Send notification' }).click();
+  await page.getByRole('button', { name: 'Send now' }).click();
+
+  await expect.poll(async () => (await sentAnnouncements(page)).length).toBe(1);
+  const [sent] = await sentAnnouncements(page);
+  expect(sent).toMatchObject({
+    courseId: 'course-1',
+    by: 'user-teacher',
+    title: 'Lecture moved',
+    body: 'Tomorrow at 10:00 instead of 12:00.',
+  });
+  // The client sends the message only; audience and deep link are the server's.
+  expect(sent).not.toHaveProperty('route');
+  expect(sent).not.toHaveProperty('userId');
+  expect(sent).not.toHaveProperty('universityId');
+});
+
+test("a teacher cannot notify another teacher's course, even calling the API directly", async ({ page, signIn }) => {
+  await signIn('teacher');
+
+  const response = await page.request.post('/api/proxy/notifications/courses/course-other/announcements', {
+    headers: { 'x-dashboard-request': '1', 'content-type': 'application/json' },
+    data: { title: 'Not my course', body: 'This must be refused.' },
+  });
+
+  expect(response.status()).toBe(403);
+  expect(await sentAnnouncements(page)).toHaveLength(0);
+});
+
+test('a teacher cannot widen the audience by adding fields', async ({ page, signIn }) => {
+  await signIn('teacher');
+
+  const response = await page.request.post('/api/proxy/notifications/courses/course-1/announcements', {
+    headers: { 'x-dashboard-request': '1', 'content-type': 'application/json' },
+    data: { title: 'Everyone', body: 'Trying to reach all students.', universityId: 'uni-1' },
+  });
+
+  expect(response.status()).toBe(422);
+  expect(await sentAnnouncements(page)).toHaveLength(0);
+});
