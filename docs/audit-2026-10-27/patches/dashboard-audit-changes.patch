+/**
+ * The table's "Created" column sorts by its key, `createdAt`, but the API's
+ * sort vocabulary is `newest | oldest | title | students | price` and an
+ * unknown value is refused with 422 - which emptied the whole list. Translated
+ * here so the URL keeps the column's own key.
+ */
+export function toCourseListQuery(
+  query: Record<string, string | number>,
+): Record<string, string | number> {
+  if (query.sort !== 'createdAt') return query;
+  const { order, ...rest } = query;
+  return { ...rest, sort: order === 'asc' ? 'oldest' : 'newest' };
+}
