+    // Credential endpoints bucket by the submitted phone ALONE.
+    //
+    // The leftmost X-Forwarded-For entry is whatever the client wrote, so an
+    // `ip|phone` key let an attacker rotate that header and get a fresh bucket
+    // for the same account on every request - unlimited guesses against one
+    // phone. Keyed by phone, the attempts against one account share one bucket
+    // whatever address they claim, and one attacker still cannot exhaust the
+    // limit for an entire NAT range. (Formatting is stripped so "010 1234" and
+    // "0101234" are the same account.)
     const phone =
