diff --git a/src/lib/client-ip-forwarding.test.ts b/src/lib/client-ip-forwarding.test.ts
new file mode 100644
index 0000000..c613fac
--- /dev/null
+++ b/src/lib/client-ip-forwarding.test.ts
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, it } from 'node:test';
+
+import {
+  CLIENT_IP_HEADER,
+  PROXY_SECRET_HEADER,
+  browserAddress,
+  clientIpForwardingHeaders,
+  readProxySecret,
+} from './client-ip-forwarding.ts';
+
+/** Owner decision D6. */
+const SECRET = 'k'.repeat(40);
+const env = { WEB_PROXY_SHARED_SECRET: SECRET };
+
+describe('forwarding the browser address to the API', () => {
+  it('forwards the Vercel-reported address together with the secret', () => {
+    const out = clientIpForwardingHeaders(new Headers({ 'x-real-ip': '197.34.10.20' }), env);
+    assert.deepEqual(out, { [CLIENT_IP_HEADER]: '197.34.10.20', [PROXY_SECRET_HEADER]: SECRET });
+  });
+
+  it('prefers x-vercel-forwarded-for, which a proxy in front of Vercel cannot overwrite', () => {
+    const out = clientIpForwardingHeaders(
+      new Headers({ 'x-vercel-forwarded-for': '41.33.1.2', 'x-real-ip': '10.0.0.1' }),
+      env,
+    );
+    assert.equal(out[CLIENT_IP_HEADER], '41.33.1.2');
+  });
+
+  it('sends nothing at all without a secret (feature off, behaviour as before)', () => {
+    assert.deepEqual(clientIpForwardingHeaders(new Headers({ 'x-real-ip': '197.34.10.20' }), {}), {});
+  });
+
+  it('ignores a secret too short to be one', () => {
+    assert.equal(readProxySecret({ WEB_PROXY_SHARED_SECRET: 'short' }), null);
+    assert.deepEqual(
+      clientIpForwardingHeaders(new Headers({ 'x-real-ip': '197.34.10.20' }), { WEB_PROXY_SHARED_SECRET: 'short' }),
+      {},
+    );
+  });
+
+  it('never takes X-Forwarded-For, or a client-sent x-edu-client-ip, as the address', () => {
+    const incoming = new Headers({ 'x-forwarded-for': '6.6.6.6', [CLIENT_IP_HEADER]: '7.7.7.7' });
+    assert.equal(browserAddress(incoming), null);
+    assert.deepEqual(clientIpForwardingHeaders(incoming, env), {});
+  });
+
+  it('refuses something that is not an address', () => {
+    assert.equal(browserAddress(new Headers({ 'x-real-ip': 'evil' })), null);
+    assert.equal(browserAddress(new Headers({ 'x-real-ip': '2001:db8::1' })), '2001:db8::1');
+  });
+});
+
+describe('the secret stays on the server', () => {
+  const SRC = join(import.meta.dirname, '..');
+  const walk = (dir: string): string[] =>
+    readdirSync(dir).flatMap((entry) => {
+      const full = join(dir, entry);
+      if (statSync(full).isDirectory()) return walk(full);
+      return /\.(ts|tsx)$/.test(full) ? [full] : [];
+    });
+  const files = walk(SRC).filter((f) => !f.endsWith('.test.ts'));
+
+  it('is never a NEXT_PUBLIC_ variable', () => {
+    for (const file of files) {
+      assert.doesNotMatch(readFileSync(file, 'utf8'), /NEXT_PUBLIC_WEB_PROXY|NEXT_PUBLIC_[A-Z_]*SECRET/, file);
+    }
+  });
+
+  it('is read only by server modules, never by a client component', () => {
+    const readers = files.filter((f) => /WEB_PROXY_SHARED_SECRET|client-ip-forwarding/.test(readFileSync(f, 'utf8')));
+    assert.ok(readers.length > 0);
+    for (const file of readers) {
+      const text = readFileSync(file, 'utf8');
+      assert.doesNotMatch(text, /^\s*['"]use client['"]/m, `${file} is a client module`);
+    }
+  });
+});
diff --git a/src/lib/client-ip-forwarding.ts b/src/lib/client-ip-forwarding.ts
new file mode 100644
index 0000000..14e046b
--- /dev/null
+++ b/src/lib/client-ip-forwarding.ts
@@ -0,0 +1,78 @@
+import { isIP } from 'node:net';
+
+/**
+ * Owner decision D6 - telling the API which browser a request is for.
+ *
+ * Every call this server makes to the API comes from a Vercel egress address
+ * that all web students share, so per-address limits, session records and
+ * security events would otherwise lump them together. Vercel overwrites
+ * `X-Forwarded-For` / `X-Real-IP` / `X-Vercel-Forwarded-For` with the real
+ * client address (it does not forward client-supplied values), so the server
+ * can read the browser's address and pass it on.
+ *
+ * The API believes the forwarded address ONLY when it arrives with the shared
+ * secret, `WEB_PROXY_SHARED_SECRET`. That secret is a server-side variable: it
+ * must never be named NEXT_PUBLIC_*, never be sent to the browser, and never be
+ * logged. This module is imported only by server code (lib/session.ts), and the
+ * headers are added to the outgoing API request, which the browser never sees.
+ *
+ * Without the secret, nothing is forwarded and the API falls back to its own
+ * view of the caller, exactly as before.
+ */
+
+export const CLIENT_IP_HEADER = 'x-edu-client-ip';
+export const PROXY_SECRET_HEADER = 'x-edu-proxy-secret';
+export const MIN_PROXY_SECRET_LENGTH = 32;
+
+/** Headers that carry the client address on Vercel, most specific first.
+ *  `X-Forwarded-For` is deliberately absent: on any host that APPENDS to it
+ *  instead of overwriting it, its first entry is client-controlled. */
+const CLIENT_ADDRESS_HEADERS = ['x-vercel-forwarded-for', 'x-real-ip'] as const;
+
+interface HeaderReader {
+  get(name: string): string | null;
+}
+
+let warnedShortSecret = false;
+
+export function readProxySecret(env: Record<string, string | undefined> = process.env): string | null {
+  const value = env.WEB_PROXY_SHARED_SECRET?.trim();
+  if (!value) return null;
+  if (value.length < MIN_PROXY_SECRET_LENGTH) {
+    if (!warnedShortSecret) {
+      warnedShortSecret = true;
+      // The value itself is never printed.
+      console.warn(
+        `[config] WEB_PROXY_SHARED_SECRET is shorter than ${MIN_PROXY_SECRET_LENGTH} characters and is ignored.`,
+      );
+    }
+    return null;
+  }
+  return value;
+}
+
+/** The browser's address as the hosting edge reported it, or null. */
+export function browserAddress(incoming: HeaderReader): string | null {
+  for (const name of CLIENT_ADDRESS_HEADERS) {
+    const raw = incoming.get(name);
+    if (!raw) continue;
+    const first = raw.split(',')[0]?.trim() ?? '';
+    if (first.length > 0 && first.length <= 45 && isIP(first)) return first;
+  }
+  return null;
+}
+
+/**
+ * The headers to add to an outgoing API call. Empty unless both a valid secret
+ * and a valid browser address are available.
+ */
+export function clientIpForwardingHeaders(
+  incoming: HeaderReader,
+  env: Record<string, string | undefined> = process.env,
+): Record<string, string> {
+  const secret = readProxySecret(env);
+  if (!secret) return {};
+  const ip = browserAddress(incoming);
+  if (!ip) return {};
+  return { [CLIENT_IP_HEADER]: ip, [PROXY_SECRET_HEADER]: secret };
+}
