# =============================================================================
# EduPlatform backend — environment template
#
# Copy to .env for local development. NEVER commit a filled-in copy.
# Every variable is validated at boot by src/config/env.validation.ts; the
# process refuses to start if a required one is missing or malformed.
# =============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development                 # development | staging | production
PORT=3000
API_PREFIX=api
API_VERSION=1

# Public base URL of this API, used to build absolute callback / manifest URLs.
PUBLIC_API_URL=http://localhost:3000

# Comma-separated allowed origins for the admin dashboard and tooling.
# Mobile apps do not send an Origin header, so they are unaffected by CORS.
# In production this must NOT be "*".
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Trust the X-Forwarded-* headers (set to true behind a load balancer / nginx).
TRUST_PROXY=false

# --- database ----------------------------------------------------------------
DATABASE_URL=postgresql://edu:edu_dev_password@localhost:5432/edu_platform?schema=public
# Optional dedicated pool for read-heavy analytics queries.
# DATABASE_REPLICA_URL=

# --- redis (cache, queues, playback concurrency, rate limiting) --------------
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=edu

# --- authentication ----------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars_long
# Must be DIFFERENT from the two above — it signs short-lived media grants.
JWT_PLAYBACK_SECRET=CHANGE_ME_playback_secret_at_least_32_chars_long

JWT_ACCESS_TTL=900                   # seconds (15 min)
JWT_REFRESH_TTL=2592000              # seconds (30 days)
JWT_ISSUER=edu-platform
JWT_AUDIENCE=edu-mobile

# Password hashing (argon2id). Raise memory on beefier hardware.
ARGON_MEMORY_COST=19456              # KiB (19 MiB) — OWASP minimum
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# --- device binding ----------------------------------------------------------
# How many devices a student account may have authorized at once.
DEVICE_LIMIT_PER_STUDENT=1
# Auto-bind the first device seen at login instead of requiring admin approval.
DEVICE_AUTO_BIND_FIRST=true
# Block protected playback when the client reports failed integrity checks.
DEVICE_BLOCK_ON_INTEGRITY_FAILURE=true

# --- playback security -------------------------------------------------------
PLAYBACK_TICKET_TTL=300              # seconds a ticket / signed manifest lives
PLAYBACK_HEARTBEAT_INTERVAL=30       # seconds between client heartbeats
PLAYBACK_HEARTBEAT_GRACE=90          # seconds without a heartbeat before the slot is reclaimed
PLAYBACK_MAX_CONCURRENT_STREAMS=1    # per student account
PLAYBACK_TICKETS_PER_HOUR=60         # anti-scraping ceiling on ticket issuance
# Stop playback server-side after this many capture attempts in one session.
PLAYBACK_CAPTURE_STRIKES=3

# --- Cloudflare R2 (video + attachments + images) ----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=edu-media-dev
R2_BUCKET_UPLOADS=edu-uploads-dev
# Library documents (PDFs, worksheets) live in their own bucket so that paid
# documents do not consume the capacity budgeted for protected video, and so
# the two can be sized and lifecycle-managed independently.
#
# Falls back to R2_BUCKET_UPLOADS when unset, which keeps an existing
# deployment working until the bucket is provisioned. Set it in production.
# The Cloudflare Worker needs a matching `LIBRARY` R2 binding — see
# wrangler.toml and docs/cloudflare-worker.js.
R2_BUCKET_LIBRARY=edu-library-dev
R2_REGION=auto
# Optional: https://<account>.r2.cloudflarestorage.com — derived if omitted.
R2_ENDPOINT=

# Public CDN hostname in front of R2 that validates our signed URLs.
# REQUIRED in production — it is what makes a media URL viewer-bound.
MEDIA_CDN_BASE_URL=

# Serve media bytes from this API when no CDN is set. Applies the same HMAC,
# ticket-liveness and quality-ceiling checks the edge Worker applies, so it is
# a transport change rather than a security relaxation — but Node proxying
# video does not scale, so it defaults ON in development and OFF in production.
# Requires PUBLIC_API_URL to be reachable from the device.
MEDIA_LOCAL_ORIGIN=
# Shared secret between this API and the Cloudflare Worker that verifies
# signatures on manifest/segment requests. Must match the Worker's secret.
MEDIA_SIGNING_KEY=CHANGE_ME_media_signing_key_at_least_32_chars

# --- video processing --------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Local scratch directory for transcoding. Needs several GB free.
TRANSCODE_WORK_DIR=/tmp/edu-transcode
# Comma-separated ladder. Renditions above the source height are skipped.
TRANSCODE_LADDER=360,480,720,1080
HLS_SEGMENT_SECONDS=6
# AES-128 HLS encryption. Per-video keys are derived from this root key.
HLS_ENCRYPTION_ENABLED=true
HLS_KEY_ROOT=CHANGE_ME_hls_key_root_at_least_32_chars_long

# --- DRM (optional, off until a provider is configured) ----------------------
DRM_ENABLED=false
DRM_WIDEVINE_LICENSE_URL=
DRM_FAIRPLAY_LICENSE_URL=
DRM_FAIRPLAY_CERT_URL=
DRM_PROVIDER_TOKEN=

# --- payments ----------------------------------------------------------------
# none | paymob | stripe  — "none" keeps the payment domain fully functional
# with a manual/admin-confirmed flow.
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=EGP
PAYMENT_RETURN_URL=eduplatform://payment/return
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- push notifications ------------------------------------------------------
# expo | none
PUSH_PROVIDER=expo
EXPO_ACCESS_TOKEN=

# --- rate limiting -----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10               # login / register attempts per TTL per IP

# --- observability -----------------------------------------------------------
LOG_LEVEL=debug                      # trace | debug | info | warn | error
LOG_PRETTY=true                      # false in production (JSON logs)
SENTRY_DSN=

# --- master bootstrap (used only by scripts/create-master.ts) ----------------
# Fill in, run `npm run bootstrap:master`, then REMOVE these values.
MASTER_PHONE=
MASTER_PASSWORD=
MASTER_FULL_NAME=
