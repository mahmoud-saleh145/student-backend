  REVOKED
}

/// What an access code unlocks.
///
/// COURSE and TEACHER codes freeze their scope at creation time: the sections
/// (or courses) that existed when the code was generated are copied into
/// `grantedSectionIds` / `grantedCourseIds`. Content added afterwards is
/// deliberately NOT unlocked by an older code — see docs/API_CONTRACT.md.
enum CodeTargetType {
  COURSE
  SECTION
  TEACHER
  /// One sellable course part. The card unlocks exactly the sections inside it.
  PART
}

/// What redeeming a code actually does.
///
/// ACCESS is the historical behaviour — the code grants course/section access
/// directly — and is therefore the default, so every pre-existing row keeps
/// meaning exactly what it meant before the wallet existed.
///
/// RECHARGE is the new model: the code carries no entitlement at all. It adds
/// credits to the student's wallet, and the student then spends those credits
/// on course parts, library parts and library packages.
enum CodeKind {
  ACCESS
  RECHARGE
}

/// How a recharge code's face value was discounted when it was sold.
enum DiscountType {
  NONE
  PERCENTAGE
  FIXED
}

/// Why credits moved.
///
/// The ledger is append-only, so a mistake is corrected by writing a
/// compensating entry (REVERSAL / ADMIN_ADJUSTMENT), never by editing history.
enum WalletTxType {
  CREDIT_RECHARGE
  PURCHASE
  REFUND
  ADMIN_ADJUSTMENT
  REVERSAL
}

/// Sign of a ledger entry. `amount` is always stored positive; this says which
/// way it moved, so a SUM over the ledger cannot be wrong about direction.
enum WalletTxDirection {
  CREDIT
  DEBIT
}

/// What originated a ledger entry. Kept separate from WalletTxType because the
/// same type (PURCHASE) arrives from several subsystems.
enum WalletTxSource {
  PAYMENT_CODE
  COURSE_PART
  LIBRARY_PART
  LIBRARY_PACKAGE
  ADMIN
  SYSTEM
}

/// How an enrollment's section entitlement was produced.
enum SectionGrantSource {
  CODE
  PAYMENT
  ADMIN
  /// The grant came from buying a course part with wallet credits.
  PART_PURCHASE
}

/// How a course part's price is expressed.
///
/// Every active part of one course must use the SAME model. Mixing them makes
/// "does the allocation add up?" unanswerable: a 40% part plus a 300 EGP part
/// only sums to the course total for one particular course price, and would
/// silently stop summing the moment that price changed.
enum PartPricingModel {
  /// A share of the course's current price. Floats with it.
  PERCENTAGE
  /// An absolute EGP amount. Fixed regardless of the course price.
  FIXED
}

/// What a library purchase bought.
enum LibraryPurchaseKind {
  PART
  PACKAGE
}

/// Why a student holds a library part.
enum LibraryEntitlementSource {
  /// Bought that part on its own.
  PURCHASE
  /// Came inside a package.
  PACKAGE
  /// Granted by an administrator.
  ADMIN
}

/// Why a student holds a part.
enum PartEntitlementSource {
  /// Historical. Course parts are acquired by code, not bought in the app.
  PURCHASE
  /// Redeemed a part-scoped access card.
  CODE
  ADMIN
  MIGRATION
}

