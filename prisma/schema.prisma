// =============================================================================
// Academic structure
// =============================================================================

// =============================================================================
// Library
//
// A separate top-level system, deliberately NOT a course:
//
//  1. **Documents only.** PDFs, papers, handouts. No videos, no lessons, no
//     enrollment. A student may buy a library part while owning no course at
//     all, and owning a course grants nothing here.
//  2. **This is what the wallet is for.** Library parts and packages are the
//     only things credits buy. Courses never debit the wallet.
//  3. **Entitlements are always at PART level.** Buying a package writes one
//     entitlement per included part. That makes the access check a single
//     lookup, and it means the package's membership is frozen by construction
//     — editing the package later cannot reach backwards and change what
//     somebody already owns.
//  4. **Nothing is ever public.** A part's `objectKey` is served only through a
//     short-lived, user- and device-bound signed URL, minted after the
//     entitlement is checked, exactly as protected course attachments already
//     are.
// =============================================================================

/// A publication: "Physics Revision Papers". Sold as its parts, or as packages.
model LibraryMaterial {
  id          String        @id @default(cuid())
  title       String
  titleAr     String?
  description String?
  /// Thumbnail in object storage. Never the document itself.
  coverKey    String?
  status      ContentStatus @default(DRAFT)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  /// Optional catalogue placement, mirroring how courses are filed, so the
  /// same browse filters work. All nullable: a material need belong to nothing.
  universityId   String?
  facultyId      String?
  academicYearId String?
  subjectId      String?

  createdById String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  university   University?   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  parts    LibraryPart[]
  packages LibraryPackage[]

  @@index([status, sortOrder])
  @@index([universityId, facultyId, academicYearId])
  @@index([subjectId])
  @@index([deletedAt])
  @@index([title])
  @@map("library_materials")
}

/// One sellable document within a material.
model LibraryPart {
  id          String        @id @default(cuid())
  materialId  String
  title       String
  titleAr     String?
  description String?
  sortOrder   Int
  status      ContentStatus @default(PUBLISHED)
  isActive    Boolean       @default(true)

  /// An absolute amount in credits. Library parts are priced individually —
  /// there is no whole-material price to take a percentage of, which is what
  /// makes this simpler than course parts.
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("EGP")

  /// The document in object storage. NEVER served directly; see the header.
  objectKey String
  mimeType  String?
  sizeBytes BigInt?
  pageCount Int?

  /// A free sample, readable without buying anything. The one documented way
  /// to get library content without an entitlement.
  isPreview Boolean @default(false)

  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  material     LibraryMaterial      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  packageItems LibraryPackageItem[]
  entitlements LibraryEntitlement[]
  purchases    LibraryPurchase[]    @relation("LibraryPartPurchases")

  @@unique([materialId, sortOrder])
  @@index([materialId, isActive, sortOrder])
  @@index([deletedAt])
  @@map("library_parts")
}

/// A bundle of parts at one price. Usually cheaper than buying them separately.
model LibraryPackage {
  id          String        @id @default(cuid())
  /// Usually one material's parts, but a package may span materials.
  materialId  String?
  title       String
  titleAr     String?
  description String?
  status      ContentStatus @default(PUBLISHED)
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("EGP")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  material  LibraryMaterial?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  items     LibraryPackageItem[]
  purchases LibraryPurchase[]    @relation("LibraryPackagePurchases")

  @@index([materialId, isActive, sortOrder])
  @@index([deletedAt])
  @@map("library_packages")
}

/// Membership. Editing this never reaches backwards into a past purchase,
/// because a purchase writes entitlements per part at the moment it happens.
model LibraryPackageItem {
  id            String   @id @default(cuid())
  packageId     String
  libraryPartId String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  package LibraryPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  part    LibraryPart    @relation(fields: [libraryPartId], references: [id], onDelete: Restrict)

  @@unique([packageId, libraryPartId])
  @@index([libraryPartId])
  @@map("library_package_items")
}

/// Immutable record of one library purchase paid for with wallet credits.
model LibraryPurchase {
  id     String              @id @default(cuid())
  userId String
  kind   LibraryPurchaseKind

  /// Exactly one is set, per `kind`, enforced by a CHECK constraint.
  libraryPartId    String?
  libraryPackageId String?

  /// What was actually spent. Frozen; never recomputed from a current price.
  priceAtPurchase Decimal @db.Decimal(12, 2)
  currency        String  @default("EGP")

  /// Denormalised so a report still reads correctly after a rename.
  titleSnapshot         String
  materialTitleSnapshot String?

  /// Exactly which parts this bought. For a package that is its membership at
  /// purchase time — the second, explicit record of what the entitlements
  /// already encode.
  partIdsSnapshot String[] @default([])

  /// The ledger entry that paid for it. Required and unique: a library
  /// purchase without a debit, or a debit without a purchase, is the failure
  /// this design exists to prevent.
  walletTransactionId String @unique

  /// `libpart:<id>:<userId>` or `libpkg:<id>:<userId>`. Makes a retried
  /// request return the original purchase instead of buying twice.
  idempotencyKey String @unique

  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user              User                 @relation("LibraryPurchaseStudent", fields: [userId], references: [id], onDelete: Restrict)
  part              LibraryPart?         @relation("LibraryPartPurchases", fields: [libraryPartId], references: [id], onDelete: Restrict)
  package           LibraryPackage?      @relation("LibraryPackagePurchases", fields: [libraryPackageId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction    @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  entitlements      LibraryEntitlement[]

  @@index([userId, purchasedAt])
  @@index([kind, purchasedAt])
  @@index([libraryPartId])
  @@index([libraryPackageId])
  @@index([purchasedAt])
  @@map("library_purchases")
}

/// What a student may open. Always per part, whatever they bought.
model LibraryEntitlement {
  id            String                   @id @default(cuid())
  userId        String
  libraryPartId String
  source        LibraryEntitlementSource @default(PURCHASE)
  purchaseId    String?

  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation("LibraryEntitlementStudent", fields: [userId], references: [id], onDelete: Restrict)
  part     LibraryPart      @relation(fields: [libraryPartId], references: [id], onDelete: Restrict)
  purchase LibraryPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  /// A student holds a part once. Two concurrent purchases cannot both create
  /// the row, and a package overlapping one already owned cannot duplicate it.
  @@unique([userId, libraryPartId])
  @@index([userId, revokedAt])
  @@index([libraryPartId, revokedAt])
  @@index([purchaseId])
  @@map("library_entitlements")
}

model University {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  code      String?  @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  faculties Faculty[]
  students  StudentProfile[]
  courses   Course[]
  libraryMaterials LibraryMaterial[]

  @@index([isActive, sortOrder])
  @@map("universities")
}

model Faculty {
  id           String   @id @default(cuid())
  universityId String
  name         String
  nameAr       String
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  university  University       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  departments Department[]
  students    StudentProfile[]
  courses     Course[]
  libraryMaterials LibraryMaterial[]

  @@unique([universityId, name])
  @@index([universityId, isActive])
  @@map("faculties")
}

model Department {
  id        String   @id @default(cuid())
  facultyId String
  name      String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  faculty  Faculty          @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  students StudentProfile[]

  @@unique([facultyId, name])
  @@index([facultyId, isActive])
  @@map("departments")
}

model AcademicYear {
  id        String   @id @default(cuid())
  /// Display/sort order (1 = first year). Never assume a fixed maximum.
  order     Int      @unique
  name      String
  nameAr    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentProfile[]
  courses  Course[]
  libraryMaterials LibraryMaterial[]

  @@map("academic_years")
}

// =============================================================================
// Users
// =============================================================================

model User {
  id           String        @id @default(cuid())
  /// Canonical Egyptian mobile form 01XXXXXXXXX. Unique across all roles.
  phone        String        @unique
  passwordHash String
  fullName     String
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  gender       Gender?
  avatarUrl    String?
  email        String?       @unique
  locale       String        @default("en")

  /// Bumped on password change / forced logout: any refresh token issued
  /// before this timestamp is rejected without needing a DB sweep.
  credentialsChangedAt DateTime @default(now())
  lastLoginAt          DateTime?
  failedLoginCount     Int      @default(0)
  lockedUntil          DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  sessions       Session[]
  refreshTokens  RefreshToken[]
  devices        Device[]
  deviceRequests DeviceChangeRequest[]

  enrollments      Enrollment[]
  payments         Payment[]
  codeRedemptions  AccessCodeRedemption[]
  watchProgress    WatchProgress[]
  watchEvents      WatchEvent[]
  playbackTickets  PlaybackTicket[]
  notifications    Notification[]
  pushTokens       PushToken[]
  notificationPrefs NotificationPreference?
  securityEvents   SecurityEvent[]
  auditLogs        AuditLog[]            @relation("AuditActor")
  issuedCodes      AccessCode[]          @relation("CodeIssuer")
  targetedByCodes  AccessCode[]          @relation("TeacherCodes")
  createdCodeBatches CodeBatch[]         @relation("BatchCreator")
  supportTickets   SupportTicket[]       @relation("TicketStudent")
  assignedTickets  SupportTicket[]       @relation("TicketAssignee")
  supportMessages  SupportMessage[]      @relation("SupportAuthor")
  courseTeachers   CourseTeacher[]
  authoredCourses  Course[]              @relation("CourseCreatedBy")
  priceChanges     CoursePrice[]         @relation("PriceChangedBy")
  revenueShares    RevenueLedger[]       @relation("RevenueTeacher")

  // --- wallet ---------------------------------------------------------------
  wallet             Wallet?
  walletTransactions WalletTransaction[]   @relation("WalletTxUser")
  walletAdjustments  WalletTransaction[]   @relation("WalletTxAdmin")
  rechargeRevenues   RechargeRevenue[]     @relation("RechargeRedeemer")

  // --- course parts ---------------------------------------------------------
  partEntitlements   CoursePartEntitlement[] @relation("PartEntitlementStudent")
  partPurchases      CoursePartPurchase[]    @relation("PartPurchaseStudent")
  partRevenueShares  CoursePartPurchase[]    @relation("PartPurchaseTeacher")
  createdParts       CoursePart[]            @relation("PartCreatedBy")

  // --- library --------------------------------------------------------------
  libraryPurchases    LibraryPurchase[]    @relation("LibraryPurchaseStudent")
  libraryEntitlements LibraryEntitlement[] @relation("LibraryEntitlementStudent")
  createdMaterials    LibraryMaterial[]    @relation("MaterialCreatedBy")

  @@index([role, status])
  @@index([status, deletedAt])
  @@index([fullName])
  @@map("users")
}

/// Academic details. Split from User so admins/teachers don't carry null
/// columns and so a student's academic record can evolve independently.
model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  universityId   String?
  facultyId      String?
  departmentId   String?
  academicYearId String?
  /// Institution-issued student number, when the platform is given one.
  studentNumber  String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University?   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([universityId, facultyId, academicYearId])
  @@map("student_profiles")
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  titleAr   String?
  bio       String?
  bioAr     String?
  /// Default share of revenue for this teacher's courses, 0..100.
  revenueSharePercent Decimal @default(0) @db.Decimal(5, 2)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// =============================================================================
// Sessions, refresh tokens, devices
// =============================================================================

model Session {
  id        String        @id @default(cuid())
  userId    String
  deviceId  String?
  status    SessionStatus @default(ACTIVE)
  ipAddress String?
  userAgent String?
  appVersion String?
  platform  String?
  createdAt DateTime      @default(now())
  lastSeenAt DateTime     @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedReason String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          Device?          @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens   RefreshToken[]
  playbackTickets PlaybackTicket[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("sessions")
}

/// Refresh tokens are stored hashed and rotated on every use. `replacedById`
/// forms a chain so reuse of an already-rotated token is detectable — the
/// classic refresh-token-theft signal — and triggers revocation of the family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  sessionId    String
  tokenHash    String    @unique
  familyId     String
  replacedById String?   @unique
  usedAt       DateTime?
  revokedAt    DateTime?
  revokedReason String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Device {
  id        String       @id @default(cuid())
  userId    String
  /// Opaque hash generated on-device and kept in the Keychain/Keystore.
  deviceKey String
  name      String
  platform  String
  model     String?
  osVersion String?
  appVersion String?
  status    DeviceStatus @default(ACTIVE)

  /// Client-reported integrity signal. A hint only — server-side attestation
  /// is the authority (see docs/SECURITY.md).
  integritySuspect Boolean @default(false)
  attestationVerifiedAt DateTime?

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  approvedAt  DateTime?
  approvedById String?
  revokedAt   DateTime?
  revokedReason String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        Session[]
  playbackTickets PlaybackTicket[]
  changeRequests  DeviceChangeRequest[]

  /// One row per (user, physical device). A second account on the same handset
  /// gets its own row, which is what lets us spot handset sharing.
  @@unique([userId, deviceKey])
  @@index([deviceKey])
  @@index([userId, status])
  @@map("devices")
}

model DeviceChangeRequest {
  id           String             @id @default(cuid())
  userId       String
  /// The device the student wants authorized.
  requestedDeviceId String?
  requestedDeviceKey String
  requestedDeviceName String
  reason       String?
  status       DeviceChangeStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedDevice Device? @relation(fields: [requestedDeviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("device_change_requests")
}

// =============================================================================
// Courses
// =============================================================================

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  titleAr          String?
  shortDescription String       @default("")
  description      String       @default("")
  thumbnailKey     String?
  status           CourseStatus @default(DRAFT)

  universityId   String?
  facultyId      String?
  academicYearId String?
  /// Optional subject/category grouping, surfaced in the dashboard's
  /// "Other data" section. Nullable so every existing course stays valid.
  subjectId      String?

  /// Which join methods the student may use. Rendered verbatim by the app.
  enrollmentMethods EnrollmentMethod[] @default([])
  isFree            Boolean            @default(false)

  accessDurationType AccessDurationType @default(LIFETIME)
  /// Used when accessDurationType = FIXED_DAYS.
  accessDurationDays Int?
  /// Used when accessDurationType = UNTIL_DATE.
  accessEndsAt       DateTime?

  /// Completion rule applied to every lesson unless the lesson overrides it.
  completionRuleType      CompletionRuleType @default(WATCH_PERCENT)
  completionThreshold     Int                @default(90)
  completionRequireContiguous Boolean        @default(true)

  requirements String[] @default([])
  outcomes     String[] @default([])

  /// Denormalised counters, maintained transactionally. They exist because the
  /// catalogue lists them on every card and recomputing per row is an N+1.
  lessonCount          Int @default(0)
  sectionCount         Int @default(0)
  totalDurationSeconds Int @default(0)
  studentCount         Int @default(0)
  ratingSum            Int @default(0)
  ratingCount          Int @default(0)

  createdById String?
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  university   University?   @relation(fields: [universityId], references: [id], onDelete: SetNull)
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subject      Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  teachers    CourseTeacher[]
  parts       CoursePart[]
  sections    CourseSection[]
  lessons     Lesson[]
  videos      Video[]
  attachments Attachment[]
  prices      CoursePrice[]
  enrollments Enrollment[]

  // Restrict: financial and analytics history pins the course row in place.
  payments        Payment[]
  codes           AccessCode[]
  watchProgress   WatchProgress[]
  watchEvents     WatchEvent[]
  playbackTickets PlaybackTicket[]
  revenue         RevenueLedger[]
  archiveRecords  ArchiveRecord[]
  partPurchases   CoursePartPurchase[]
  partEntitlements CoursePartEntitlement[]

  @@index([status, publishedAt])
  @@index([universityId, academicYearId, status])
  @@index([deletedAt])
  @@index([title])
  @@index([subjectId])
  @@map("courses")
}

/// Subject / category. Purely an organisational grouping over courses — it
/// grants nothing and gates nothing, so adding it cannot affect access.
model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  courses Course[]
  libraryMaterials LibraryMaterial[]

  @@index([isActive, sortOrder])
  @@map("subjects")
}

/// Many-to-many so a course can be co-taught without duplicating the course.
model CourseTeacher {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  /// The lead teacher is the one shown on cards when space allows one name.
  isLead    Boolean  @default(false)
  /// Per-assignment override of the teacher's default revenue share.
  revenueSharePercent Decimal? @db.Decimal(5, 2)
  canEditContent  Boolean @default(true)
  canEditPricing  Boolean @default(false)
  canPublish      Boolean @default(false)
  canViewStudents Boolean @default(true)
  canViewRevenue  Boolean @default(false)
  assignedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId])
  @@map("course_teachers")
}

/// Versioned pricing. A new row is appended on every change; the previous row
/// gets `effectiveTo`. Payments reference the exact version they used, so
/// historical revenue can never be recomputed from the current price.
model CoursePrice {
  id           String   @id @default(cuid())
  courseId     String
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("EGP")
  /// Optional strike-through price for a promotion.
  compareAtAmount Decimal? @db.Decimal(12, 2)
  version      Int
  isCurrent    Boolean  @default(true)
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  changedById  String?
  reason       String?
  createdAt    DateTime @default(now())

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  changedBy User?     @relation("PriceChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@unique([courseId, version])
  @@index([courseId, isCurrent])
  @@map("course_prices")
}

/// Dynamic course structure. No assumption is made anywhere about how many
/// sections exist or what they are called.
model CourseSection {
  id          String        @id @default(cuid())
  courseId    String
  /// The part this section belongs to, if the course is divided into parts.
  ///
  /// Nullable, and null for every section that existed before parts did — a
  /// course with no parts keeps behaving exactly as it always has. A section
  /// belongs to at most one part, because a section in two parts would have
  /// two prices and no answer to "what did the student buy?".
  partId      String?
  title       String
  titleAr     String?
  description String?
  sortOrder   Int
  status      ContentStatus @default(PUBLISHED)
  /// Drip release: hidden until this timestamp.
  unlocksAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a part must never delete the teaching
  // material inside it. The sections simply become unassigned.
  part    CoursePart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  lessons Lesson[]

  codes  AccessCode[]             @relation("SectionCodes")
  grants EnrollmentSectionGrant[]

  @@unique([courseId, sortOrder])
  @@index([courseId, status, sortOrder])
  @@index([partId])
  @@map("course_sections")
}

model Lesson {
  id          String        @id @default(cuid())
  courseId    String
  sectionId   String
  title       String
  titleAr     String?
  description String?
  kind        LessonKind    @default(VIDEO)
  sortOrder   Int
  status      ContentStatus @default(PUBLISHED)
  /// Free preview lessons are playable before enrolling.
  isPreview   Boolean       @default(false)
  durationSeconds Int       @default(0)

  /// Per-lesson override of the course completion rule.
  completionRuleType          CompletionRuleType?
  completionThreshold         Int?
  completionRequireContiguous Boolean?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  video       Video?
  attachments Attachment[]

  watchProgress WatchProgress[]
  watchEvents   WatchEvent[]
  playbackTickets PlaybackTicket[]

  @@unique([sectionId, sortOrder])
  @@index([courseId, status])
  @@index([sectionId, status, sortOrder])
  @@index([title])
  @@map("lessons")
}

// =============================================================================
// Video
// =============================================================================

/// Metadata only. The bytes live in Cloudflare R2; nothing here is a playable
/// URL. A playable URL only ever comes from a PlaybackTicket.
model Video {
  id       String      @id @default(cuid())
  lessonId String      @unique
  courseId String
  status   VideoStatus @default(UPLOADING)

  /// R2 object key of the master/source upload. Never exposed to students.
  sourceKey     String?
  sourceSizeBytes BigInt?
  sourceMimeType String?
  /// R2 prefix under which the HLS output lives, e.g. "hls/<videoId>/".
  hlsPrefix     String?
  /// Object key of the master playlist inside hlsPrefix.
  masterPlaylistKey String?
  thumbnailKey  String?

  durationSeconds Int    @default(0)
  width           Int?
  height          Int?
  frameRate       Float?
  videoCodec      String?
  audioCodec      String?

  /// AES-128 HLS key material. `encryptionKeyId` names a key derived from
  /// HLS_KEY_ROOT; the key bytes are never stored in the database.
  isEncrypted     Boolean @default(false)
  encryptionKeyId String?

  processingJobId String?
  processingError String?
  processingStartedAt DateTime?
  processedAt     DateTime?
  uploadedById    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  renditions VideoRendition[]
  captions   CaptionTrack[]
  tickets    PlaybackTicket[]
  watchEvents WatchEvent[]

  @@index([courseId, status])
  @@index([status, createdAt])
  @@map("videos")
}

model VideoRendition {
  id        String   @id @default(cuid())
  videoId   String
  /// 360 | 480 | 720 | 1080 …
  height    Int
  width     Int
  bitrateKbps Int
  playlistKey String
  sizeBytes BigInt?
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, height])
  @@index([videoId])
  @@map("video_renditions")
}

model CaptionTrack {
  id        String   @id @default(cuid())
  videoId   String
  language  String
  label     String
  objectKey String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, language])
  @@map("caption_tracks")
}

// =============================================================================
// Attachments
// =============================================================================

model Attachment {
  id       String         @id @default(cuid())
  courseId String
  lessonId String?
  title    String
  titleAr  String?
  kind     AttachmentKind @default(PDF)
  objectKey String
  mimeType String?
  sizeBytes BigInt?
  pageCount Int?
  /// Protected attachments are served through a ticket and never downloadable.
  isProtected  Boolean @default(true)
  isDownloadable Boolean @default(false)
  /// Available to non-enrolled students (syllabus, sample chapter).
  isPreview    Boolean @default(false)
  sortOrder    Int     @default(0)
  uploadedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId, deletedAt])
  @@index([lessonId])
  @@map("attachments")
}

// =============================================================================
// Enrollment & access
// =============================================================================

model Enrollment {
  id       String          @id @default(cuid())
  userId   String
  courseId String
  state    EnrollmentState
  method   EnrollmentMethod

  accessStartsAt DateTime  @default(now())
  /// Null = lifetime access.
  accessEndsAt   DateTime?

  approvedById String?
  approvedAt   DateTime?
  revokedById  String?
  revokedAt    DateTime?
  revokedReason String?

  /// Progress snapshot, maintained on completion transitions so the course
  /// list doesn't have to aggregate watch_progress per row.
  completedLessons Int      @default(0)
  lastLessonId     String?
  lastAccessedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// True (the historical and default behaviour) means this enrollment covers
  /// every section of the course. It is only set false by a SECTION-scoped
  /// code, in which case `sectionGrants` lists exactly what is unlocked.
  coversAllSections Boolean @default(true)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  payments      Payment[]
  redemptions   AccessCodeRedemption[]
  sectionGrants EnrollmentSectionGrant[]

  /// A student has at most one enrollment row per course; re-joining after
  /// expiry updates this row and appends a new payment/redemption.
  @@unique([userId, courseId])
  @@index([courseId, state])
  @@index([userId, state])
  @@index([accessEndsAt, state])
  @@map("enrollments")
}

/// Section-level entitlement.
///
/// Only meaningful when `Enrollment.coversAllSections` is false. Rows are
/// append-only: buying a second section adds a row, it never rewrites one, so
/// what a student paid for stays reconstructible.
model EnrollmentSectionGrant {
  id           String             @id @default(cuid())
  enrollmentId String
  sectionId    String
  source       SectionGrantSource @default(CODE)
  codeId       String?
  /// Set when the grant came from a part purchase, so "why can this student
  /// see this section?" has an answer without joining through purchases.
  partId       String?
  createdAt    DateTime           @default(now())

  enrollment Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  section    CourseSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  part       CoursePart?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, sectionId])
  @@index([sectionId])
  @@index([partId])
  @@map("enrollment_section_grants")
}

// =============================================================================
// Payments & revenue
// =============================================================================

model Payment {
  id           String          @id @default(cuid())
  userId       String
  courseId     String
  enrollmentId String?
  /// The exact price version charged. Immutable evidence of what was owed.
  coursePriceId String?

  /// The exact amount charged, frozen at purchase time. Never derived from
  /// the course's current price.
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("EGP")
  status   PaymentStatus @default(PENDING)
  provider PaymentProvider @default(MANUAL)

  /// Provider-side identifier, unique per provider.
  providerReference String?
  /// Our own idempotency key, echoed to the provider where supported.
  idempotencyKey    String  @unique
  checkoutUrl       String?

  paidAt      DateTime?
  failedAt    DateTime?
  failureCode String?
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)
  refundedAt  DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment  Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  coursePrice CoursePrice? @relation(fields: [coursePriceId], references: [id], onDelete: Restrict)

  transactions PaymentTransaction[]
  revenue      RevenueLedger[]

  @@index([userId, status])
  @@index([courseId, status])
  @@index([status, createdAt])
  @@index([providerReference])
  @@map("payments")
}

/// Append-only provider event log. Webhooks land here before mutating the
/// Payment, so a replayed or out-of-order webhook is diagnosable.
model PaymentTransaction {
  id        String   @id @default(cuid())
  paymentId String
  /// authorize | capture | fail | refund | webhook | manual_confirm
  type      String
  status    String
  amount    Decimal? @db.Decimal(12, 2)
  currency  String?
  providerReference String?
  /// Raw provider payload, redacted of card data before storage.
  rawPayload Json?
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([providerReference])
  @@map("payment_transactions")
}

/// Immutable revenue lines, written once when a payment is captured.
/// Archiving or repricing a course never touches these rows.
model RevenueLedger {
  id        String   @id @default(cuid())
  paymentId String
  courseId  String
  teacherId String?

  grossAmount    Decimal @db.Decimal(12, 2)
  platformAmount Decimal @db.Decimal(12, 2)
  teacherAmount  Decimal @db.Decimal(12, 2)
  sharePercent   Decimal @db.Decimal(5, 2)
  currency       String  @default("EGP")

  /// Denormalised for reporting after a course is renamed or archived.
  courseTitleSnapshot String
  recognizedAt        DateTime @default(now())
  createdAt           DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  teacher User?   @relation("RevenueTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([courseId, recognizedAt])
  @@index([teacherId, recognizedAt])
  @@index([recognizedAt])
  @@map("revenue_ledger")
}

// =============================================================================
// Access codes
// =============================================================================

model AccessCode {
  id       String     @id @default(cuid())
  /// Stored uppercase; unique platform-wide so a code can be redeemed without
  /// the student first selecting the right course.
  code     String     @unique
  courseId String?
  status   CodeStatus @default(ACTIVE)

  /// Null = any student may redeem it.
  reservedForUserId String?

  maxRedemptions Int @default(1)
  redemptionCount Int @default(0)

  /// Access granted by redeeming. Falls back to the course policy when null.
  accessDurationType AccessDurationType?
  accessDurationDays Int?
  accessEndsAt       DateTime?

  /// The code itself stops working after this date.
  expiresAt DateTime?

  batchId   String?
  note      String?
  issuedById String?
  revokedAt DateTime?
  revokedById String?

  // --- targeting (added for the admin dashboard) -----------------------------

  /// COURSE is the historical behaviour and therefore the default, so every
  /// pre-existing row keeps meaning exactly what it meant before.
  targetType CodeTargetType @default(COURSE)

  /// Set when targetType = SECTION.
  sectionId String?
  /// Set when targetType = TEACHER.
  teacherId String?
  /// Set when targetType = PART.
  coursePartId String?

  /// Scope frozen at generation time. Empty means "no snapshot was taken",
  /// which is how legacy rows are distinguished from a genuinely empty scope;
  /// those fall back to the whole course, preserving old behaviour.
  grantedSectionIds String[] @default([])
  grantedCourseIds  String[] @default([])

  /// Face value recorded on the card, for reporting. This is NOT the money
  /// authority — revenue always comes from revenue_ledger.
  priceAmount Decimal? @db.Decimal(12, 2)
  currency    String   @default("EGP")

  // --- wallet recharge (added with the credit system) ------------------------

  /// ACCESS is the pre-wallet behaviour and therefore the default: every row
  /// that existed before this column keeps granting course access exactly as
  /// it did. Only rows explicitly created as RECHARGE touch the wallet.
  kind CodeKind @default(ACCESS)

  /// The four numbers that make a recharge code auditable. All are frozen at
  /// creation and never recomputed:
  ///   faceValue        — what is printed on the card
  ///   discountAmount   — the absolute discount, derived once from the type
  ///   actualPaidAmount — what the student actually handed over: THE REVENUE
  ///   creditAmount     — what lands in the wallet (equal to actualPaidAmount)
  /// A 100% discount is legal and yields 0 / 0 / 0 for the last three.
  faceValue        Decimal?     @db.Decimal(12, 2)
  discountType     DiscountType @default(NONE)
  discountPercent  Decimal?     @db.Decimal(5, 2)
  discountAmount   Decimal?     @db.Decimal(12, 2)
  actualPaidAmount Decimal?     @db.Decimal(12, 2)
  creditAmount     Decimal?     @db.Decimal(12, 2)

  /// Denormalised for the admin list, which sorts and filters on them. The
  /// authority remains access_code_redemptions.
  redeemedAt     DateTime?
  redeemedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course?                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  section     CourseSection?         @relation("SectionCodes", fields: [sectionId], references: [id], onDelete: Restrict)
  teacher     User?                  @relation("TeacherCodes", fields: [teacherId], references: [id], onDelete: Restrict)
  coursePart  CoursePart?            @relation("PartCodes", fields: [coursePartId], references: [id], onDelete: Restrict)
  batch       CodeBatch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  issuedBy    User?                  @relation("CodeIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  redemptions AccessCodeRedemption[]

  rechargeRevenue RechargeRevenue?
  partAcquisition CoursePartPurchase? @relation("PartAcquiredByCode")

  @@index([courseId, status])
  @@index([batchId])
  @@index([status, expiresAt])
  @@index([targetType, status])
  @@index([sectionId])
  @@index([teacherId])
  @@index([kind, status])
  @@index([kind, createdAt])
  @@index([redeemedAt])
  @@index([coursePartId])
  @@map("access_codes")
}

/// A generated batch of cards.
///
/// `AccessCode.batchId` already existed as a loose uuid; this promotes it to a
/// real row so a batch can carry a human name, its target and its size without
/// re-deriving them by scanning thousands of codes.
model CodeBatch {
  id   String  @id @default(cuid())
  /// Optional human label ("Term 2 — Pharmacy cards").
  name String?

  targetType   CodeTargetType
  courseId     String?
  sectionId    String?
  teacherId    String?
  coursePartId String?
  /// Denormalised so an archived or renamed target still reads correctly.
  targetNameSnapshot String

  quantity    Int
  prefix      String?
  priceAmount Decimal? @db.Decimal(12, 2)
  currency    String   @default("EGP")
  expiresAt   DateTime?
  note        String?

  // --- wallet recharge -------------------------------------------------------
  /// The configuration every card in this batch was stamped with. Stored on
  /// the batch as well as the card so an admin can see what was sold without
  /// opening a card, and so a later change to the cards is detectable.
  kind             CodeKind     @default(ACCESS)
  faceValue        Decimal?     @db.Decimal(12, 2)
  discountType     DiscountType @default(NONE)
  discountPercent  Decimal?     @db.Decimal(5, 2)
  discountAmount   Decimal?     @db.Decimal(12, 2)
  actualPaidAmount Decimal?     @db.Decimal(12, 2)
  creditAmount     Decimal?     @db.Decimal(12, 2)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy  User?              @relation("BatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  coursePart CoursePart?        @relation("PartCodeBatches", fields: [coursePartId], references: [id], onDelete: Restrict)
  codes      AccessCode[]
  revenue    RechargeRevenue[]

  @@index([createdAt])
  @@index([targetType])
  @@index([kind, createdAt])
  @@map("code_batches")
}

/// Append-only. One row per successful redemption; the unique constraint is
/// what makes a single-use code genuinely single-use under concurrency.
model AccessCodeRedemption {
  id           String   @id @default(cuid())
  codeId       String
  userId       String
  enrollmentId String?
  /// Null for a RECHARGE code: it buys credits, not a course. Every row that
  /// existed before the wallet keeps its course, so nothing historical moves.
  courseId     String?
  redeemedAt   DateTime @default(now())
  ipAddress    String?
  deviceKey    String?

  /// Set when redeeming credited a wallet. Links the redemption to the exact
  /// ledger entry it produced, which is what makes the credit traceable in
  /// both directions.
  walletTransactionId String?  @unique
  creditedAmount      Decimal? @db.Decimal(12, 2)

  code              AccessCode         @relation(fields: [codeId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollment        Enrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  walletTransaction WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  /// A student cannot redeem the same code twice, ever.
  @@unique([codeId, userId])
  @@index([userId, redeemedAt])
  @@index([courseId])
  @@map("access_code_redemptions")
}

// =============================================================================
// Playback authorization
// =============================================================================

/// One row per issued playback grant. Kept after expiry as the audit trail of
/// who was authorized to watch what, from where, and when.
model PlaybackTicket {
  id        String               @id @default(cuid())
  userId    String
  videoId   String
  lessonId  String
  courseId  String
  sessionId String?
  deviceId  String?
  status    PlaybackTicketStatus @default(ACTIVE)

  /// Opaque forensic tag embedded in the watermark payload.
  watermarkTag String
  /// Server-chosen quality ceiling for this grant (null = full ladder).
  maxHeight    Int?

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  lastHeartbeatAt DateTime @default(now())
  releasedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?

  /// Rotation chain, so a long lesson's successive grants stay linked.
  rotatedFromId String?  @unique

  startPositionSeconds Int @default(0)
  lastPositionSeconds  Int @default(0)
  watchedSeconds       Int @default(0)
  captureAttempts      Int @default(0)

  ipAddress String?
  userAgent String?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  session     Session?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device      Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  rotatedFrom PlaybackTicket? @relation("TicketRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotatedTo   PlaybackTicket? @relation("TicketRotation")
  securityEvents SecurityEvent[]

  @@index([userId, status, expiresAt])
  @@index([videoId, issuedAt])
  @@index([status, expiresAt])
  @@map("playback_tickets")
}

// =============================================================================
// Progress & analytics
// =============================================================================

model WatchProgress {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  courseId String

  positionSeconds Int @default(0)
  durationSeconds Int @default(0)
  /// 0..100. Monotonic — the service never lets it decrease.
  percent         Int @default(0)
  /// Contiguous seconds actually watched, ignoring seeks. Drives the
  /// requireContiguous completion rule.
  watchedSeconds  Int @default(0)

  completed   Boolean   @default(false)
  completedAt DateTime?
  firstWatchedAt DateTime @default(now())
  lastWatchedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@index([userId, lastWatchedAt])
  @@index([courseId, completed])
  @@map("watch_progress")
}

/// Coarse analytics events. Deliberately NOT one row per second — the service
/// writes STARTED / COMPLETED plus a throttled PROGRESS heartbeat.
model WatchEvent {
  id       String         @id @default(cuid())
  userId   String
  lessonId String
  courseId String
  videoId  String?
  ticketId String?
  type     WatchEventType

  positionSeconds Int @default(0)
  /// New contiguous seconds since the previous event.
  deltaSeconds    Int @default(0)
  qualityHeight   Int?
  platform        String?
  occurredAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  video  Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([courseId, occurredAt])
  @@index([lessonId, occurredAt])
  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@map("watch_events")
}

/// Nightly rollup so dashboards never scan watch_events.
model DailyCourseStat {
  id       String   @id @default(cuid())
  courseId String
  day      DateTime @db.Date

  uniqueViewers   Int @default(0)
  watchSeconds    Int @default(0)
  lessonsStarted  Int @default(0)
  lessonsCompleted Int @default(0)
  newEnrollments  Int @default(0)
  revenueAmount   Decimal @default(0) @db.Decimal(12, 2)
  currency        String  @default("EGP")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, day])
  @@index([day])
  @@map("daily_course_stats")
}

// =============================================================================
// Notifications
// =============================================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  kind   NotificationKind

  title   String
  titleAr String?
  body    String
  bodyAr  String?
  /// Validated in-app path, e.g. "/course/abc". Never an external URL.
  route   String?
  imageUrl String?
  data    Json?

  read   Boolean   @default(false)
  readAt DateTime?

  /// Set when this notification came from a broadcast announcement.
  announcementId String?

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A single admin-authored message fanned out into per-user notifications.
model Announcement {
  id      String @id @default(cuid())
  title   String
  titleAr String?
  body    String
  bodyAr  String?
  route   String?

  /// Legacy flat targeting, kept so announcements created before the audience
  /// builder keep working unchanged. Read only when `audienceRule` is null.
  courseId       String?
  universityId   String?
  academicYearId String?

  /// The audience rule, re-evaluated at every send. Validated against
  /// `AudienceRule` before storage — never interpolated into a query.
  /// Null means: fall back to the three columns above.
  audienceRule Json?

  status AnnouncementStatus @default(DRAFT)

  // --- scheduling ------------------------------------------------------------
  /// The wall-clock time of day occurrences fire, as "HH:MM" in `timezone`.
  /// Stored as local time rather than UTC on purpose: "every Sunday at 19:00"
  /// must stay 19:00 for the student when Egypt's clocks change.
  sendAtLocal String?
  timezone    String  @default("Africa/Cairo")

  frequency  AnnouncementFrequency @default(ONCE)
  /// WEEKLY only. ISO weekdays, 1 = Monday … 7 = Sunday.
  weekdays   Int[]
  /// MONTHLY only. 1–31; a month shorter than this clamps to its last day.
  dayOfMonth Int?

  startsOn DateTime?
  endsOn   DateTime?
  /// Stop after this many sends, whatever `endsOn` says. Null = unlimited.
  maxOccurrences Int?
  occurrenceCount Int @default(0)

  /// The next instant this should fire, in UTC. The dispatcher's only index.
  /// Null means nothing further is due — sent, cancelled or exhausted.
  nextOccurrenceAt DateTime?
  lastOccurrenceAt DateTime?

  sendPush  Boolean   @default(true)
  publishedAt DateTime?
  createdById String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  notifications Notification[]
  dispatches    AnnouncementDispatch[]

  @@index([publishedAt])
  @@index([status, nextOccurrenceAt])
  @@map("announcements")
}

/// One row per occurrence actually dispatched.
///
/// The unique constraint is the concurrency control, not a report: a worker
/// claims an occurrence by inserting this row and only then fans out, so two
/// workers racing on the same minute produce one send and one `P2002`. A push
/// cannot be recalled, which is why the claim has to precede the send.
model AnnouncementDispatch {
  id             String   @id @default(cuid())
  announcementId String
  /// The scheduled instant this row claims — not when the work ran.
  occurrenceAt   DateTime

  recipientCount Int      @default(0)
  createdCount   Int      @default(0)
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  /// Set when the fan-out threw. The claim is kept either way, so a failure
  /// is visible rather than silently retried into a duplicate send.
  error          String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, occurrenceAt])
  @@index([occurrenceAt])
  @@map("announcement_dispatches")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  newCourse     Boolean @default(true)
  newLesson     Boolean @default(true)
  announcements Boolean @default(true)
  payments      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  provider  String   @default("expo")
  /// Ties the token to the physical device so unbinding kills its pushes.
  deviceKey String?
  isActive  Boolean  @default(true)
  lastUsedAt DateTime?
  failureCount Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_tokens")
}

// =============================================================================
// Security & audit
// =============================================================================

model SecurityEvent {
  id       String            @id @default(cuid())
  userId   String?
  type     SecurityEventType
  severity SecuritySeverity  @default(INFO)

  courseId  String?
  lessonId  String?
  videoId   String?
  ticketId  String?
  deviceKey String?
  sessionId String?

  ipAddress String?
  userAgent String?
  message   String?
  metadata  Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // Optional: some events (a failed login with an unknown phone) have no user.
  user   User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket PlaybackTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
  @@index([severity, occurredAt])
  @@map("security_events")
}

/// Append-only administrative trail. No update or delete path exists in the
/// application layer.
model AuditLog {
  id       String      @id @default(cuid())
  actorId  String?
  actorRole UserRole?
  action   AuditAction
  /// e.g. "course", "user", "access_code"
  entity   String
  entityId String?

  /// Redacted before/after snapshots for diffing.
  before Json?
  after  Json?

  ipAddress String?
  userAgent String?
  requestId String?
  note      String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Why and when content was archived, and by whom. The content row itself
/// keeps its data; this explains the state transition.
model ArchiveRecord {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  courseId String?
  reason   String?
  /// Counts frozen at archive time so reports stay meaningful afterwards.
  snapshot Json?
  archivedById String?
  archivedAt   DateTime  @default(now())
  restoredById String?
  restoredAt   DateTime?

  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@index([entity, entityId])
  @@index([courseId])
  @@map("archive_records")
}

// =============================================================================
// Support
// =============================================================================

/// A student-raised support conversation.
///
/// Nothing here is ever hard-deleted: closing a ticket is a status change, so
/// the history stays available for dispute resolution.
model SupportTicket {
  id        String                @id @default(cuid())
  /// Short human-facing reference shown to the student ("TK-000123").
  reference String                @unique
  userId    String
  subject   String
  category  SupportTicketCategory @default(GENERAL)
  status    SupportTicketStatus   @default(OPEN)
  priority  SupportTicketPriority @default(NORMAL)

  /// Optional context the student was looking at when they wrote in.
  courseId String?

  assignedToId String?
  /// Denormalised for cheap inbox sorting without joining messages.
  lastMessageAt DateTime  @default(now())
  lastMessageBy String?
  /// Unread-for-staff counter, maintained on write.
  unreadForStaff Int      @default(0)
  resolvedAt    DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation("TicketStudent", fields: [userId], references: [id], onDelete: Restrict)
  assignedTo User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
  @@index([assignedToId, status])
  @@map("support_tickets")
}

/// Append-only message log. There is no update or delete path in the API.
model SupportMessage {
  id       String @id @default(cuid())
  ticketId String
  authorId String?
  /// Snapshotted so a message still reads correctly if the author is removed.
  authorRole UserRole
  body     String
  /// Staff-only note, never shown to the student.
  isInternal Boolean @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// =============================================================================
// Platform configuration
// =============================================================================

// =============================================================================
// Wallet / credits
//
// Money rules, stated once here because every method in the wallet service
// depends on them:
//
//  1. `wallet_transactions` is the source of truth. `wallets.balance` is a
//     maintained cache kept for read performance; it is only ever changed in
//     the same transaction as the ledger row that explains the change, and
//     `SUM(credits) - SUM(debits)` must always reproduce it. The consistency
//     check endpoint asserts exactly that.
//  2. The ledger is append-only. There is no update or delete path. A mistake
//     is corrected by a compensating REVERSAL / ADMIN_ADJUSTMENT entry.
//  3. A balance can never go negative. Three independent mechanisms enforce
//     it: a conditional `UPDATE ... WHERE balance >= amount`, a Serializable
//     transaction, and a CHECK constraint in the database as the backstop.
//  4. Cash enters the system exactly once, at recharge, and is recognised as
//     `recharge_revenue.actualPaidAmount`. Spending credits on a course part
//     or a library item is an *allocation* of cash already recognised, not new
//     revenue — counting both would double-count every pound.
// =============================================================================

/// One wallet per user, created lazily on first use.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  /// Cached balance. Authority is the ledger; see the header note above.
  balance  Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("EGP")

  /// Lifetime totals, maintained alongside the balance for the admin view so
  /// a student row does not require two aggregate queries to render.
  totalRecharged Decimal @default(0) @db.Decimal(12, 2)
  totalSpent     Decimal @default(0) @db.Decimal(12, 2)

  /// Incremented on every mutation. Not used for locking (the conditional
  /// UPDATE does that) but it makes a lost update visible after the fact.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([balance])
  @@map("wallets")
}

/// Append-only credit ledger. Every movement of credit has exactly one row.
model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  userId   String

  type      WalletTxType
  direction WalletTxDirection
  source    WalletTxSource    @default(SYSTEM)

  /// Always positive. `direction` carries the sign.
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("EGP")

  /// The balance either side of this entry, frozen at write time. This is what
  /// lets an auditor replay the ledger and prove the cached balance, and what
  /// lets the student app show a running balance without recomputing.
  balanceBefore Decimal @db.Decimal(12, 2)
  balanceAfter  Decimal @db.Decimal(12, 2)

  /// What this entry was for. `referenceType` / `referenceId` is a deliberate
  /// loose coupling: course-part and library purchases arrive in later phases
  /// and must not each require a new nullable FK column on this table.
  accessCodeId  String?
  referenceType String?
  referenceId   String?

  /// Set when an administrator moved credit by hand. Required by the service
  /// for ADMIN_ADJUSTMENT, together with `note`.
  performedByAdminId String?
  note               String?
  metadata           Json?

  /// Guards against a retried request crediting twice. Scoped per operation,
  /// e.g. `recharge:<codeId>:<userId>`.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user               User                  @relation("WalletTxUser", fields: [userId], references: [id], onDelete: Restrict)
  performedByAdmin   User?                 @relation("WalletTxAdmin", fields: [performedByAdminId], references: [id], onDelete: SetNull)
  codeRedemption     AccessCodeRedemption?
  coursePartPurchase CoursePartPurchase?
  libraryPurchase    LibraryPurchase?

  @@index([walletId, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([referenceType, referenceId])
  @@index([accessCodeId])
  @@map("wallet_transactions")
}

/// Immutable cash-in record for one redeemed recharge code.
///
/// Separate from `revenue_ledger` on purpose: that table recognises *course*
/// revenue and carries a teacher share, which a wallet top-up has neither of.
/// Platform cash collected = SUM(actualPaidAmount) here.
model RechargeRevenue {
  id           String  @id @default(cuid())
  accessCodeId String  @unique
  batchId      String?
  userId       String

  faceValue        Decimal      @db.Decimal(12, 2)
  discountType     DiscountType @default(NONE)
  discountPercent  Decimal?     @db.Decimal(5, 2)
  discountAmount   Decimal      @default(0) @db.Decimal(12, 2)
  /// The revenue. Face value minus discount — never the face value itself.
  actualPaidAmount Decimal      @db.Decimal(12, 2)
  creditAmount     Decimal      @db.Decimal(12, 2)
  currency         String       @default("EGP")

  /// Denormalised so the report still reads correctly after a batch is renamed.
  batchNameSnapshot String?
  codeSnapshot      String

  recognizedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  accessCode AccessCode @relation(fields: [accessCodeId], references: [id], onDelete: Restrict)
  batch      CodeBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  user       User       @relation("RechargeRedeemer", fields: [userId], references: [id], onDelete: Restrict)

  @@index([recognizedAt])
  @@index([userId, recognizedAt])
  @@index([batchId, recognizedAt])
  @@map("recharge_revenue")
}

// =============================================================================
// Course parts
//
// A part is a sellable slice of a course: "Before Mid + revision" at 60% of the
// course price, say. The rules that shape every model below:
//
//  1. **A part is a group of sections.** It is not a new content type and not a
//     new authorization system. Buying a part writes ordinary
//     `enrollment_section_grants` rows for the sections inside it, which is
//     what the lesson, playback and attachment gates already read. Nothing in
//     the access path changes.
//  2. **Parts are optional.** A course with no parts sells and behaves exactly
//     as it did before this feature existed. `course_sections.partId` is null
//     for every section that predates it.
//  3. **Course parts never touch the wallet.** The wallet is for the Library
//     only. A part is unlocked by redeeming a part-scoped access card, and the
//     money changes hands offline when that card is sold — exactly as the
//     course-scoped and section-scoped cards already work. Like those,
//     redemption writes no `payment` and no `revenue_ledger` row; the card's
//     face value is the reporting figure. `course_part_purchases` is the
//     acquisition record the specification requires, not a cash record.
//  4. **A purchase is frozen.** Price, pricing model, titles, teacher share and
//     the exact sections unlocked are all snapshotted at purchase. A later
//     price change, retitle or restructure cannot rewrite what someone paid.
// =============================================================================

/// One sellable slice of a course.
model CoursePart {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  titleAr     String?
  description String?
  sortOrder   Int
  status      ContentStatus @default(PUBLISHED)

  /// Inactive parts stay visible to admins and keep their purchase history,
  /// but cannot be bought. Deactivating is how a part is retired without
  /// destroying what students already own.
  isActive Boolean @default(true)

  /// Exactly one of `pricePercent` / `priceAmount` is set, per `pricingModel`.
  /// The service validates the whole course's allocation on every write; the
  /// CHECK constraints in the migration stop a hand-edited row being nonsense.
  pricingModel PartPricingModel @default(PERCENTAGE)
  pricePercent Decimal?         @db.Decimal(5, 2)
  priceAmount  Decimal?         @db.Decimal(12, 2)
  currency     String           @default("EGP")

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  course       Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("PartCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sections     CourseSection[]
  grants       EnrollmentSectionGrant[]
  entitlements CoursePartEntitlement[]
  purchases    CoursePartPurchase[]
  codes        AccessCode[]             @relation("PartCodes")
  codeBatches  CodeBatch[]              @relation("PartCodeBatches")

  @@unique([courseId, sortOrder])
  @@index([courseId, isActive, sortOrder])
  @@index([deletedAt])
  @@map("course_parts")
}

/// What a student owns.
///
/// The unique `(userId, coursePartId)` index is the double-purchase guarantee:
/// two concurrent buy requests for the same part cannot both create a row,
/// whatever the application does, and whichever loses the race rolls its wallet
/// debit back with it.
model CoursePartEntitlement {
  id           String @id @default(cuid())
  userId       String
  coursePartId String
  /// Denormalised so "which parts of course X does this student own?" is one
  /// indexed read rather than a join through parts.
  courseId     String

  source     PartEntitlementSource @default(PURCHASE)
  purchaseId String?               @unique

  grantedAt     DateTime  @default(now())
  /// Revocation is additive: the row stays, so the history of what was owned
  /// and when it was withdrawn survives.
  revokedAt     DateTime?
  revokedById   String?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation("PartEntitlementStudent", fields: [userId], references: [id], onDelete: Restrict)
  part     CoursePart          @relation(fields: [coursePartId], references: [id], onDelete: Restrict)
  course   Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase CoursePartPurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, coursePartId])
  @@index([userId, courseId])
  @@index([courseId, grantedAt])
  @@index([coursePartId, revokedAt])
  @@map("course_part_entitlements")
}

/// Immutable record of one part bought with wallet credits.
///
/// This is an ALLOCATION record, not a revenue record. The money was recognised
/// as cash when the student bought their credits; this says which course and
/// teacher it was ultimately spent on. Summing these alongside
/// `recharge_revenue` would double-count every pound.
model CoursePartPurchase {
  id           String @id @default(cuid())
  userId       String
  courseId     String
  coursePartId String

  /// What the student actually paid. Frozen. Never recomputed from the part's
  /// current price, which is the entire point of storing it.
  priceAtPurchase Decimal @db.Decimal(12, 2)
  currency        String  @default("EGP")

  /// The configuration that produced that number, kept so the figure can be
  /// explained years later without guessing.
  pricingModelAtPurchase PartPricingModel
  pricePercentAtPurchase Decimal?         @db.Decimal(5, 2)
  coursePriceAtPurchase  Decimal?         @db.Decimal(12, 2)

  /// Denormalised titles, so a report still reads correctly after a rename.
  partTitleSnapshot   String
  courseTitleSnapshot String

  /// Teacher attribution computed at purchase time from the course assignment.
  /// Stored rather than derived because the share percentage can change.
  teacherId      String?
  sharePercent   Decimal? @db.Decimal(5, 2)
  teacherAmount  Decimal  @default(0) @db.Decimal(12, 2)
  platformAmount Decimal  @default(0) @db.Decimal(12, 2)

  /// Exactly which sections this unlocked. A part restructured later does not
  /// change what this purchase bought.
  sectionIdsSnapshot String[] @default([])

  /// How the part was acquired. Exactly one of these is set, enforced by a
  /// CHECK constraint.
  ///
  /// `accessCodeId` is the live path: course parts are unlocked by redeeming a
  /// part-scoped card, and the money changes hands offline when the card is
  /// sold. `walletTransactionId` is nullable history from the build in which
  /// parts were briefly bought with wallet credits; the wallet is now for the
  /// Library only and nothing new is ever written to this column.
  ///
  /// The `@relation` on each is not decoration. Declaring a column and its
  /// unique index without one leaves Prisma unaware of the foreign key, which
  /// it then removes as drift the next time a migration runs.
  walletTransactionId String? @unique
  accessCodeId        String? @unique

  /// `part:<partId>:<userId>`. Makes a retried request return the original
  /// purchase instead of buying twice.
  idempotencyKey String @unique

  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user        User                   @relation("PartPurchaseStudent", fields: [userId], references: [id], onDelete: Restrict)
  teacher     User?                  @relation("PartPurchaseTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  part              CoursePart             @relation(fields: [coursePartId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction?     @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  accessCode        AccessCode?            @relation("PartAcquiredByCode", fields: [accessCodeId], references: [id], onDelete: Restrict)
  entitlement       CoursePartEntitlement?

  @@index([userId, purchasedAt])
  @@index([courseId, purchasedAt])
  @@index([coursePartId, purchasedAt])
  @@index([teacherId, purchasedAt])
  @@index([purchasedAt])
  @@map("course_part_purchases")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("platform_settings")
}

/// Idempotency guard for webhooks and retried mutations.
model IdempotencyRecord {
  key        String   @id
  scope      String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@map("idempotency_records")
}
